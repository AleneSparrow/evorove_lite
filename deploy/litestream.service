[Unit]
Description=Continuous SQLite replication to Cloudflare R2
Wants=network-online.target
After=network-online.target evorove.service

[Service]
Type=simple
User=evorove
Group=evorove
EnvironmentFile=/etc/evorove/litestream.env
ExecStart=/usr/bin/litestream replicate -config /etc/litestream.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/evorove

[Install]
WantedBy=multi-user.target
